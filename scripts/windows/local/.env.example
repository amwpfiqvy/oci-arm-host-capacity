# Copy to .env (gitignored) and fill in. Values mirror the GitHub Actions
# secrets/vars of oci-arm-capacity.yml, which cannot be read back from GitHub.
OCI_REGION=
OCI_USER_ID=
OCI_TENANCY_ID=
OCI_KEY_FINGERPRINT=
# Private key file name placed in THIS directory (PEM, RSA).
OCI_PRIVATE_KEY_FILENAME=oci_api_key.pem
OCI_SUBNET_ID=
OCI_IMAGE_ID=
OCI_SSH_PUBLIC_KEY=
OCI_OCPUS=2
OCI_MEMORY_IN_GBS=12
OCI_MAX_INSTANCES=2
OCI_BOOT_VOLUME_SIZE_IN_GBS=50
# Instance/hostname prefix: picks first free prefix1..prefix9 (e.g. apq).
OCI_INSTANCE_NAME_PREFIX=
# Optional: pin one availability domain; empty = try all.
OCI_AVAILABILITY_DOMAIN=
# Optional: ServerChan notify key (SCT...), skip notification if empty.
SERVERCHAN_SENDKEY=
